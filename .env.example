CAMPUS_LLM_URL=http://111.32.22.35:32592/mgate/v1/chat/completions
CAMPUS_LLM_MODEL=glm-5.1
CAMPUS_LLM_API_KEY=
# SDK base_url is derived ONCE by removing /chat/completions.
CAMPUS_ASR_URL=
CAMPUS_ASR_MODEL=
CAMPUS_ASR_API_KEY=
# ASR is a separate OpenAI-compatible audio/transcriptions service.
# URL is its base URL (for example https://your-asr-host/v1), not chat/completions.
# Browser recording is decoded/resampled to real 16kHz mono PCM16 WAV; max 30s.
# All three ASR fields are required. Never put credentials in VITE_* variables.
CAMPUS_TTS_PROVIDER=edge
CAMPUS_TTS_VOICE=zh-CN-XiaoxiaoNeural
# Only M/C explicitly set AI4TJU_ENV_FILE=E:\AI4TJU\.env in their process.

# Optional map enhancement; no key is needed for the local guide.
CAMPUS_AMAP_JS_KEY=
# Server-only security secret and separate Web Service key. Never VITE_*.
CAMPUS_AMAP_SECURITY_KEY=
CAMPUS_AMAP_WEB_SERVICE_KEY=
# Legacy search settings; the campus workflow now uses only registered public pages.
# Registry/budgets/TTLs: docs/evaluation/starter/{source_registry,retrieval_policy}.json
# No external search-provider capability is claimed without separate configuration.
CAMPUS_WEB_SEARCH_ENABLED=true
CAMPUS_WEB_SEARCH_TIMEOUT=12
CAMPUS_WEB_SEARCH_BACKEND=bing,duckduckgo,brave
# Fast deterministic tour drafts; optional model suggestions are not needed for selected IDs.
CAMPUS_TOUR_MODEL_SUGGESTIONS=false
