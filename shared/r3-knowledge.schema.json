{
  "contract_version": "1.2.0",
  "schemas": {
    "ApplicableEvidence": {
      "$defs": {
        "Evidence": {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "title": "Evidence Id",
              "type": "string"
            },
            "source_ref": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Source Ref",
              "type": "string"
            },
            "claim": {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "\\S",
              "title": "Claim",
              "type": "string"
            },
            "relation": {
              "enum": [
                "retrieved",
                "supports",
                "contradicts"
              ],
              "title": "Relation",
              "type": "string"
            },
            "verification": {
              "enum": [
                "verified",
                "unverified",
                "historical",
                "disputed"
              ],
              "title": "Verification",
              "type": "string"
            },
            "checked_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Checked At"
            },
            "valid_until": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Valid Until"
            }
          },
          "required": [
            "evidence_id",
            "source_ref",
            "claim",
            "relation",
            "verification",
            "checked_at"
          ],
          "title": "Evidence",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "poi_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Poi Id",
          "type": "string"
        },
        "campus_id": {
          "enum": [
            "weijinlu",
            "beiyangyuan"
          ],
          "title": "Campus Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "claim_type": {
          "enum": [
            "stable_fact",
            "published_rule",
            "historical_event",
            "field_observation"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "applicable_at": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable At"
        },
        "audience": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_through": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Through"
        },
        "source_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Checked At"
        },
        "field_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Checked At"
        },
        "current_status": {
          "enum": [
            "confirmed",
            "pending",
            "expired",
            "conflict",
            "unknown"
          ],
          "title": "Current Status",
          "type": "string"
        },
        "conflict_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Conflict Ids",
          "type": "array"
        }
      },
      "required": [
        "poi_id",
        "campus_id",
        "evidence",
        "claim_type",
        "current_status"
      ],
      "title": "ApplicableEvidence",
      "type": "object"
    },
